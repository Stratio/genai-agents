#!/usr/bin/env python3
"""The artifact commands that share or destroy: `share`, `delete` and `rm`.

They live in scripts/artifact.py with the rest; this executable is only their way in.
Run it as it is (`scripts/artifact-manage rm <id> <path>`), never through `python3`: the
sandbox asks the person before any command that names this file, and an "always" answer
then covers this executable alone instead of every `python3` command.
"""

import importlib.util
import os
import sys

_spec = importlib.util.spec_from_file_location(
    "artifact", os.path.join(os.path.dirname(os.path.realpath(__file__)), "artifact.py")
)
artifact = importlib.util.module_from_spec(_spec)
_spec.loader.exec_module(artifact)

if __name__ == "__main__":
    artifact.main(sys.argv[1:], manage=True)
